+def solve_with_pathway_pilot_cplex(
+    n: pypsa.Network,
+    solve_kwargs: dict[str, Any],
+) -> tuple[str, str]:
+    """Solve PyPSA-Eur's constructed Linopy LP with pathway-pilot CPLEX."""
+
+    project_root = Path(__file__).resolve().parents[2]
+    source_root = project_root / "src"
+    if str(source_root) not in sys.path:
+        sys.path.insert(0, str(source_root))
+
+    from pathway_pilot.cplex_callable import solve_with_cplex_callable
+
+    options = dict(solve_kwargs.get("solver_options") or {})
+    status, condition, timings = solve_with_cplex_callable(
+        n.model,
+        gams_dir=options.get("gams_dir"),
+        work_dir=options.get("work_dir"),
+        threads=int(options.get("threads", 6)),
+        method=str(options.get("method", "barrier")),
+    )
+    if status == "ok":
+        n.optimize.assign_solution()
+        n.optimize.assign_duals(
+            assign_all_duals=bool(solve_kwargs.get("assign_all_duals", False))
+        )
+        n.optimize.post_processing()
+    n.meta["pathway_pilot_cplex"] = {
+        "transfer": "direct",
+        "status": status,
+        "termination_condition": condition,
+        "method": str(options.get("method", "barrier")),
+        "threads": int(options.get("threads", 6)),
+        "model_export_seconds": timings.export_seconds,
+        "solver_read_seconds": timings.read_seconds,
+        "model_transfer_seconds": timings.export_seconds + timings.read_seconds,
+        "solver_seconds": timings.solve_seconds,
+    }
+    logger.info(
+        "Direct CPLEX timings: MPS export %.3fs, CPLEX read %.3fs, solve %.3fs",
+        timings.export_seconds,
+        timings.read_seconds,
+        timings.solve_seconds,
+    )
+    return status, condition
+
